# Copy this file to .env for local-only bootstrap settings.
# Do not commit populated local values.

BLACKBOX_SOURCE_PROFILE=gng
BLACKBOX_MAME_DRIVER=gngb
BLACKBOX_MAME_BINARY=mame
BLACKBOX_FFMPEG_BINARY=ffmpeg
BLACKBOX_ROM_PATH=REPLACE_ME_PRIVATE_ROM_DIR
BLACKBOX_EVIDENCE_ROOT=evidence/private
BLACKBOX_BOOT_PLAN=plans/gng_boot_only.yaml
BLACKBOX_TRACE_INPUT_PLAN=plans/gng_gameplay.yaml
BLACKBOX_TRACE_OUTPUT=specs/traces/gng_trace.json
