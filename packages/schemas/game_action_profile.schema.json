{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game Action Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_type",
    "id",
    "source_profile",
    "driver",
    "canonical_to_action",
    "allowed_actions",
    "metadata"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_type": { "const": "game_action_profile" },
    "id": { "type": "string" },
    "source_profile": { "type": "string" },
    "driver": { "type": "string" },
    "canonical_to_action": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "required": ["clean_room_safe"],
      "properties": {
        "clean_room_safe": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
